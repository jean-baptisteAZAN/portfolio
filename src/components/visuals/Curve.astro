---
/** Probability that the speaker is done, crossing the decision threshold. */
---
<svg class="curve" viewBox="0 0 240 100" preserveAspectRatio="none" aria-hidden="true">
  <line class="th" x1="0" y1="32" x2="240" y2="32" stroke-dasharray="3 4" stroke-width="1" />
  <path class="l" d="M0 90 C40 88 60 80 90 72 S130 70 150 55 S190 20 240 10" fill="none" stroke-width="2" vector-effect="non-scaling-stroke" />
</svg>
<style>
  .curve { width: 100%; height: 100%; padding: 46px 18px 6px; overflow: visible; }
  .th { stroke: var(--accent); }
  .l { stroke: currentColor; stroke-dasharray: 400; stroke-dashoffset: 400; animation: draw 3.2s var(--ease) infinite; }
  @keyframes draw { 70%, 100% { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .l { animation: none; stroke-dashoffset: 0; } }
</style>
